{
  "name": "@useairfoil/producer-shopify",
  "version": "0.2.2",
  "repository": "useairfoil/connector-kit",
  "files": [
    "dist",
    "src",
    "README.md"
  ],
  "type": "module",
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs",
      "default": "./dist/index.mjs"
    },
    "./manifest": {
      "types": "./dist/manifest.d.mts",
      "import": "./dist/manifest.mjs",
      "default": "./dist/manifest.mjs"
    }
  },
  "scripts": {
    "build": "tsdown",
    "docker:build": "docker build --load --file Dockerfile --tag airfoil/producer-shopify:local ../..",
    "start": "tsx --env-file=.env src/main.ts start",
    "sandbox": "tsx --env-file=.env src/main.ts sandbox",
    "demo": "tsx src/main.ts demo",
    "test": "dotenvx run --ignore=MISSING_ENV_FILE --quiet -- vitest",
    "test:ci": "dotenvx run --ignore=MISSING_ENV_FILE --quiet -- vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@effect/platform-node": "catalog:",
    "@effect/sql-pg": "catalog:",
    "@useairfoil/connector-kit": "workspace:*",
    "effect": "catalog:"
  },
  "devDependencies": {
    "@dotenvx/dotenvx": "^1.62.0",
    "@effect/vitest": "catalog:",
    "@types/node": "catalog:",
    "@useairfoil/effect-vcr": "workspace:*",
    "tsdown": "catalog:",
    "tsx": "^4.21.0",
    "vitest": "catalog:"
  }
}
