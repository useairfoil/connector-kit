GITHUB_APP_CLIENT_ID=Iv23li_XX
# The PEM can stay on one line with \n for newlines.
GITHUB_APP_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\nXX\n-----END RSA PRIVATE KEY-----"
GITHUB_INSTALLATION_ID=12345678
GITHUB_WEBHOOK_SECRET=XX
AIRFOIL_HTTP_PORT=8080

ENGINE_URI=http://localhost:7777
AIRFOIL_CATALOG=default-catalog
AIRFOIL_TABLE_BINDINGS={"repositories":{"namespace":["default"],"name":"github_repositories"},"issues":{"namespace":["default"],"name":"github_issues"},"pull_requests":{"namespace":["default"],"name":"github_pull_requests"},"issue_comments":{"namespace":["default"],"name":"github_issue_comments"},"pull_request_reviews":{"namespace":["default"],"name":"github_pull_request_reviews"},"pull_request_review_comments":{"namespace":["default"],"name":"github_pull_request_review_comments"},"pull_request_commits":{"namespace":["default"],"name":"github_pull_request_commits"},"commits":{"namespace":["default"],"name":"github_commits"},"check_runs":{"namespace":["default"],"name":"github_check_runs"},"commit_statuses":{"namespace":["default"],"name":"github_commit_statuses"},"workflow_runs":{"namespace":["default"],"name":"github_workflow_runs"},"workflow_jobs":{"namespace":["default"],"name":"github_workflow_jobs"},"releases":{"namespace":["default"],"name":"github_releases"}}

# Production `start` also requires a mounted connector JSON file and PostgreSQL state.
# Sandboxes do not use these values.
# AIRFOIL_CONFIG_PATH=/var/run/airfoil/config/config.json
# AIRFOIL_CONNECTOR_INSTANCE_ID=team-acme-github-primary
# POSTGRES_CONNECTION_STRING=postgresql://user:password@localhost:5432/airfoil

# Optional OpenTelemetry trace and metric export. Logs remain local.
# The endpoint is the OTLP base URL; Connector Kit appends /v1/traces and /v1/metrics.
OTEL_ENABLED=false
OTEL_SERVICE_NAME=producer-github
# OTEL_SERVICE_VERSION=0.1.0
# OTEL_RESOURCE_ATTRIBUTES=service.instance.id=team-acme-github-primary,airfoil.connector.revision=1,airfoil.team.id=team-acme
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# OTEL_EXPORTER_OTLP_HEADERS=Authorization=Bearer <token>,X-Axiom-Dataset=<dataset>
