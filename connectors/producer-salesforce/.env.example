# OTEL_RESOURCE_ATTRIBUTES=service.instance.id=team-acme-salesforce-primary,airfoil.connector.revision=1,airfoil.team.id=team-acme
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
