LINEAR_API_KEY=lin_api_XX
LINEAR_WEBHOOK_SECRET=XX
AIRFOIL_HTTP_PORT=8080

ENGINE_URI=http://localhost:7777
AIRFOIL_CATALOG=default-catalog
AIRFOIL_TABLE_BINDINGS={"issues":{"namespace":["default"],"name":"linear_issues"},"issue_history":{"namespace":["default"],"name":"linear_issue_history"},"comments":{"namespace":["default"],"name":"linear_comments"},"issue_relations":{"namespace":["default"],"name":"linear_issue_relations"},"attachments":{"namespace":["default"],"name":"linear_attachments"},"issue_labels":{"namespace":["default"],"name":"linear_issue_labels"},"workflow_states":{"namespace":["default"],"name":"linear_workflow_states"},"teams":{"namespace":["default"],"name":"linear_teams"},"team_memberships":{"namespace":["default"],"name":"linear_team_memberships"},"users":{"namespace":["default"],"name":"linear_users"},"external_users":{"namespace":["default"],"name":"linear_external_users"},"cycles":{"namespace":["default"],"name":"linear_cycles"},"projects":{"namespace":["default"],"name":"linear_projects"},"project_milestones":{"namespace":["default"],"name":"linear_project_milestones"},"project_updates":{"namespace":["default"],"name":"linear_project_updates"},"project_statuses":{"namespace":["default"],"name":"linear_project_statuses"},"project_labels":{"namespace":["default"],"name":"linear_project_labels"},"project_relations":{"namespace":["default"],"name":"linear_project_relations"},"initiatives":{"namespace":["default"],"name":"linear_initiatives"},"initiative_updates":{"namespace":["default"],"name":"linear_initiative_updates"},"initiative_labels":{"namespace":["default"],"name":"linear_initiative_labels"},"initiative_relations":{"namespace":["default"],"name":"linear_initiative_relations"},"initiative_to_projects":{"namespace":["default"],"name":"linear_initiative_to_projects"},"documents":{"namespace":["default"],"name":"linear_documents"},"customers":{"namespace":["default"],"name":"linear_customers"},"customer_needs":{"namespace":["default"],"name":"linear_customer_needs"},"customer_statuses":{"namespace":["default"],"name":"linear_customer_statuses"},"customer_tiers":{"namespace":["default"],"name":"linear_customer_tiers"},"releases":{"namespace":["default"],"name":"linear_releases"},"release_notes":{"namespace":["default"],"name":"linear_release_notes"},"release_pipelines":{"namespace":["default"],"name":"linear_release_pipelines"},"release_stages":{"namespace":["default"],"name":"linear_release_stages"},"issue_to_releases":{"namespace":["default"],"name":"linear_issue_to_releases"}}

# Production `start` also requires a mounted connector JSON file and PostgreSQL state.
# Sandboxes do not use these values.
# AIRFOIL_CONFIG_PATH=/var/run/airfoil/config/config.json
# AIRFOIL_CONNECTOR_INSTANCE_ID=team-acme-linear-primary
# POSTGRES_CONNECTION_STRING=postgresql://user:password@localhost:5432/airfoil

# Optional OpenTelemetry trace and metric export. Logs remain local.
# The endpoint is the OTLP base URL; Connector Kit appends /v1/traces and /v1/metrics.
OTEL_ENABLED=false
OTEL_SERVICE_NAME=producer-linear
# OTEL_SERVICE_VERSION=0.1.0
# OTEL_RESOURCE_ATTRIBUTES=service.instance.id=team-acme-linear-primary,airfoil.connector.revision=1,airfoil.team.id=team-acme
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# OTEL_EXPORTER_OTLP_HEADERS=Authorization=Bearer <token>,X-Axiom-Dataset=<dataset>
