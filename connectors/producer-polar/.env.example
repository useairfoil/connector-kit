POLAR_ACCESS_TOKEN=polar_oat_XX
POLAR_ORGANIZATION_ID=512929b6-XX
POLAR_WEBHOOK_SECRET=polar_whs_XXX
AIRFOIL_HTTP_PORT=8080
# Required by `start`; `sandbox` injects https://sandbox-api.polar.sh/v1/.
POLAR_API_BASE_URL=https://api.polar.sh/v1/

ENGINE_URI=http://localhost:7777
AIRFOIL_CATALOG=default-catalog
AIRFOIL_TABLE_BINDINGS={"customers":{"namespace":["default"],"name":"polar_customers"},"checkouts":{"namespace":["default"],"name":"polar_checkouts"},"orders":{"namespace":["default"],"name":"polar_orders"},"subscriptions":{"namespace":["default"],"name":"polar_subscriptions"},"refunds":{"namespace":["default"],"name":"polar_refunds"},"products":{"namespace":["default"],"name":"polar_products"},"discounts":{"namespace":["default"],"name":"polar_discounts"}}

# Production `start` also requires a mounted connector JSON file and PostgreSQL state.
# Sandboxes do not use these values.
# AIRFOIL_CONFIG_PATH=/var/run/airfoil/config/config.json
# AIRFOIL_CONNECTOR_INSTANCE_ID=team-acme-polar-primary
# POSTGRES_CONNECTION_STRING=postgresql://user:password@localhost:5432/airfoil

# Optional OpenTelemetry trace and metric export. Logs remain local.
# The endpoint is the OTLP base URL; Connector Kit appends /v1/traces and /v1/metrics.
OTEL_ENABLED=false
OTEL_SERVICE_NAME=producer-polar
# OTEL_SERVICE_VERSION=0.1.0
# OTEL_RESOURCE_ATTRIBUTES=service.instance.id=team-acme-polar-primary,airfoil.connector.revision=1,airfoil.team.id=team-acme
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# OTEL_EXPORTER_OTLP_HEADERS=Authorization=Bearer <token>,X-Axiom-Dataset=<dataset>
