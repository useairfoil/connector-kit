HUBSPOT_ACCESS_TOKEN=pat-na1-XX
# Turns on webhooks. Leave unset to poll only.
# HUBSPOT_CLIENT_SECRET=XX
AIRFOIL_HTTP_PORT=8080

ENGINE_URI=http://localhost:7777
AIRFOIL_CATALOG=default-catalog
AIRFOIL_TABLE_BINDINGS={"contacts":{"namespace":["default"],"name":"hubspot_contacts"},"companies":{"namespace":["default"],"name":"hubspot_companies"},"deals":{"namespace":["default"],"name":"hubspot_deals"},"tickets":{"namespace":["default"],"name":"hubspot_tickets"},"calls":{"namespace":["default"],"name":"hubspot_calls"},"emails":{"namespace":["default"],"name":"hubspot_emails"},"meetings":{"namespace":["default"],"name":"hubspot_meetings"},"notes":{"namespace":["default"],"name":"hubspot_notes"},"tasks":{"namespace":["default"],"name":"hubspot_tasks"},"communications":{"namespace":["default"],"name":"hubspot_communications"},"postal_mail":{"namespace":["default"],"name":"hubspot_postal_mail"},"feedback_submissions":{"namespace":["default"],"name":"hubspot_feedback_submissions"},"line_items":{"namespace":["default"],"name":"hubspot_line_items"},"products":{"namespace":["default"],"name":"hubspot_products"},"quotes":{"namespace":["default"],"name":"hubspot_quotes"},"leads":{"namespace":["default"],"name":"hubspot_leads"},"invoices":{"namespace":["default"],"name":"hubspot_invoices"},"orders":{"namespace":["default"],"name":"hubspot_orders"},"carts":{"namespace":["default"],"name":"hubspot_carts"},"commerce_payments":{"namespace":["default"],"name":"hubspot_commerce_payments"},"subscriptions":{"namespace":["default"],"name":"hubspot_subscriptions"},"discounts":{"namespace":["default"],"name":"hubspot_discounts"},"fees":{"namespace":["default"],"name":"hubspot_fees"},"taxes":{"namespace":["default"],"name":"hubspot_taxes"},"goal_targets":{"namespace":["default"],"name":"hubspot_goal_targets"},"users":{"namespace":["default"],"name":"hubspot_users"},"deal_split":{"namespace":["default"],"name":"hubspot_deal_split"},"custom_objects":{"namespace":["default"],"name":"hubspot_custom_objects"},"owners":{"namespace":["default"],"name":"hubspot_owners"},"pipelines":{"namespace":["default"],"name":"hubspot_pipelines"},"properties":{"namespace":["default"],"name":"hubspot_properties"},"teams":{"namespace":["default"],"name":"hubspot_teams"},"lists":{"namespace":["default"],"name":"hubspot_lists"}}

# Production `start` also requires a mounted connector JSON file and PostgreSQL state.
# Sandboxes do not use these values.
# AIRFOIL_CONFIG_PATH=/var/run/airfoil/config/config.json
# AIRFOIL_CONNECTOR_INSTANCE_ID=team-acme-hubspot-primary
# POSTGRES_CONNECTION_STRING=postgresql://user:password@localhost:5432/airfoil

# Optional OpenTelemetry trace and metric export. Logs remain local.
# The endpoint is the OTLP base URL; Connector Kit appends /v1/traces and /v1/metrics.
OTEL_ENABLED=false
OTEL_SERVICE_NAME=producer-hubspot
# OTEL_SERVICE_VERSION=0.1.0
# OTEL_RESOURCE_ATTRIBUTES=service.instance.id=team-acme-hubspot-primary,airfoil.connector.revision=1,airfoil.team.id=team-acme
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# OTEL_EXPORTER_OTLP_HEADERS=Authorization=Bearer <token>,X-Axiom-Dataset=<dataset>
