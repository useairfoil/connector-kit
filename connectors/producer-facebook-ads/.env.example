FACEBOOK_ADS_ACCESS_TOKEN=EAAXX
FACEBOOK_ADS_ACCOUNT_IDS=1234567890
# FACEBOOK_ADS_START_DATE=2024-01-01
# FACEBOOK_ADS_LOOKBACK_DAYS=28
AIRFOIL_HTTP_PORT=8080

ENGINE_URI=http://localhost:7777
AIRFOIL_CATALOG=default-catalog
AIRFOIL_TABLE_BINDINGS={"ad_accounts":{"namespace":["default"],"name":"facebook_ads_ad_accounts"},"campaigns":{"namespace":["default"],"name":"facebook_ads_campaigns"},"ad_sets":{"namespace":["default"],"name":"facebook_ads_ad_sets"},"ads":{"namespace":["default"],"name":"facebook_ads_ads"},"ads_insights":{"namespace":["default"],"name":"facebook_ads_ads_insights"},"ads_insights_age_gender":{"namespace":["default"],"name":"facebook_ads_ads_insights_age_gender"},"ads_insights_country":{"namespace":["default"],"name":"facebook_ads_ads_insights_country"},"ads_insights_platform":{"namespace":["default"],"name":"facebook_ads_ads_insights_platform"}}

# Production `start` also requires a mounted connector JSON file and PostgreSQL state.
# Sandboxes do not use these values.
# AIRFOIL_CONFIG_PATH=/var/run/airfoil/config/config.json
# AIRFOIL_CONNECTOR_INSTANCE_ID=team-acme-facebook-ads-primary
# POSTGRES_CONNECTION_STRING=postgresql://user:password@localhost:5432/airfoil

# Optional OpenTelemetry trace and metric export. Logs remain local.
# The endpoint is the OTLP base URL; Connector Kit appends /v1/traces and /v1/metrics.
OTEL_ENABLED=false
OTEL_SERVICE_NAME=producer-facebook-ads
# OTEL_SERVICE_VERSION=0.1.0
# OTEL_RESOURCE_ATTRIBUTES=service.instance.id=team-acme-facebook-ads-primary,airfoil.connector.revision=1,airfoil.team.id=team-acme
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# OTEL_EXPORTER_OTLP_HEADERS=Authorization=Bearer <token>,X-Axiom-Dataset=<dataset>
