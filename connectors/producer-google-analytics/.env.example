GA_PROPERTY_ID=123456789
GA_CLIENT_EMAIL=reader@project.iam.gserviceaccount.com
GA_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nXX\n-----END PRIVATE KEY-----\n"
# GA_START_DATE=2024-01-01
# GA_LOOKBACK_DAYS=14
AIRFOIL_HTTP_PORT=8080

ENGINE_URI=http://localhost:7777
AIRFOIL_CATALOG=default-catalog
AIRFOIL_TABLE_BINDINGS={"daily_overview":{"namespace":["default"],"name":"google_analytics_daily_overview"},"traffic_sources":{"namespace":["default"],"name":"google_analytics_traffic_sources"},"user_acquisition":{"namespace":["default"],"name":"google_analytics_user_acquisition"},"pages":{"namespace":["default"],"name":"google_analytics_pages"},"landing_pages":{"namespace":["default"],"name":"google_analytics_landing_pages"},"events":{"namespace":["default"],"name":"google_analytics_events"},"locations":{"namespace":["default"],"name":"google_analytics_locations"},"devices":{"namespace":["default"],"name":"google_analytics_devices"},"ecommerce_items":{"namespace":["default"],"name":"google_analytics_ecommerce_items"}}

# Production `start` also requires a mounted connector JSON file and PostgreSQL state.
# Sandboxes do not use these values.
# AIRFOIL_CONFIG_PATH=/var/run/airfoil/config/config.json
# AIRFOIL_CONNECTOR_INSTANCE_ID=team-acme-google-analytics-primary
# POSTGRES_CONNECTION_STRING=postgresql://user:password@localhost:5432/airfoil

# Optional OpenTelemetry trace and metric export. Logs remain local.
# The endpoint is the OTLP base URL; Connector Kit appends /v1/traces and /v1/metrics.
OTEL_ENABLED=false
OTEL_SERVICE_NAME=producer-google-analytics
# OTEL_SERVICE_VERSION=0.1.0
# OTEL_RESOURCE_ATTRIBUTES=service.instance.id=team-acme-google-analytics-primary,airfoil.connector.revision=1,airfoil.team.id=team-acme
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# OTEL_EXPORTER_OTLP_HEADERS=Authorization=Bearer <token>,X-Axiom-Dataset=<dataset>
