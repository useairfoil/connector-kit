STRIPE_API_KEY=rk_test_XX
STRIPE_WEBHOOK_SECRET=whsec_XX
AIRFOIL_HTTP_PORT=8080
# Optional. Shared by all resources.
# STRIPE_RATE_LIMIT_PER_SECOND=20

ENGINE_URI=http://localhost:7777
AIRFOIL_CATALOG=default-catalog
AIRFOIL_TABLE_BINDINGS={"customers":{"namespace":["default"],"name":"stripe_customers"},"products":{"namespace":["default"],"name":"stripe_products"},"prices":{"namespace":["default"],"name":"stripe_prices"},"subscriptions":{"namespace":["default"],"name":"stripe_subscriptions"},"invoices":{"namespace":["default"],"name":"stripe_invoices"},"charges":{"namespace":["default"],"name":"stripe_charges"},"refunds":{"namespace":["default"],"name":"stripe_refunds"}}

# Production `start` also requires a mounted connector JSON file and PostgreSQL state.
# Sandboxes do not use these values.
# AIRFOIL_CONFIG_PATH=/var/run/airfoil/config/config.json
# AIRFOIL_CONNECTOR_INSTANCE_ID=team-acme-stripe-primary
# POSTGRES_CONNECTION_STRING=postgresql://user:password@localhost:5432/airfoil

# Optional OpenTelemetry trace and metric export. Logs remain local.
# The endpoint is the OTLP base URL; Connector Kit appends /v1/traces and /v1/metrics.
OTEL_ENABLED=false
OTEL_SERVICE_NAME=producer-stripe
# OTEL_SERVICE_VERSION=0.1.0
# OTEL_RESOURCE_ATTRIBUTES=service.instance.id=team-acme-stripe-primary,airfoil.connector.revision=1,airfoil.team.id=team-acme
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# OTEL_EXPORTER_OTLP_HEADERS=Authorization=Bearer <token>,X-Axiom-Dataset=<dataset>
