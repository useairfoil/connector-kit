ZENDESK_SUBDOMAIN=acme
ZENDESK_CLIENT_ID=airfoil
ZENDESK_CLIENT_SECRET=XX
AIRFOIL_HTTP_PORT=8080

ENGINE_URI=http://localhost:7777
AIRFOIL_CATALOG=default-catalog
AIRFOIL_TABLE_BINDINGS={"tickets":{"namespace":["default"],"name":"zendesk_tickets"},"ticket_comments":{"namespace":["default"],"name":"zendesk_ticket_comments"},"users":{"namespace":["default"],"name":"zendesk_users"},"organizations":{"namespace":["default"],"name":"zendesk_organizations"},"groups":{"namespace":["default"],"name":"zendesk_groups"},"brands":{"namespace":["default"],"name":"zendesk_brands"},"ticket_fields":{"namespace":["default"],"name":"zendesk_ticket_fields"},"ticket_forms":{"namespace":["default"],"name":"zendesk_ticket_forms"},"custom_statuses":{"namespace":["default"],"name":"zendesk_custom_statuses"},"survey_responses":{"namespace":["default"],"name":"zendesk_survey_responses"},"csat_surveys":{"namespace":["default"],"name":"zendesk_csat_surveys"},"ticket_field_history":{"namespace":["default"],"name":"zendesk_ticket_field_history"},"ticket_metric_events":{"namespace":["default"],"name":"zendesk_ticket_metric_events"},"satisfaction_ratings":{"namespace":["default"],"name":"zendesk_satisfaction_ratings"},"group_memberships":{"namespace":["default"],"name":"zendesk_group_memberships"},"organization_memberships":{"namespace":["default"],"name":"zendesk_organization_memberships"},"user_fields":{"namespace":["default"],"name":"zendesk_user_fields"},"organization_fields":{"namespace":["default"],"name":"zendesk_organization_fields"},"custom_roles":{"namespace":["default"],"name":"zendesk_custom_roles"},"sla_policies":{"namespace":["default"],"name":"zendesk_sla_policies"},"schedules":{"namespace":["default"],"name":"zendesk_schedules"},"macros":{"namespace":["default"],"name":"zendesk_macros"},"articles":{"namespace":["default"],"name":"zendesk_articles"},"sections":{"namespace":["default"],"name":"zendesk_sections"},"categories":{"namespace":["default"],"name":"zendesk_categories"},"community_posts":{"namespace":["default"],"name":"zendesk_community_posts"},"community_topics":{"namespace":["default"],"name":"zendesk_community_topics"},"talk_lines":{"namespace":["default"],"name":"zendesk_talk_lines"}}

# Production `start` also requires a mounted connector JSON file and PostgreSQL state.
# Sandboxes do not use these values.
# AIRFOIL_CONFIG_PATH=/var/run/airfoil/config/config.json
# AIRFOIL_CONNECTOR_INSTANCE_ID=team-acme-zendesk-primary
# POSTGRES_CONNECTION_STRING=postgresql://user:password@localhost:5432/airfoil

# Optional OpenTelemetry trace and metric export. Logs remain local.
# The endpoint is the OTLP base URL; Connector Kit appends /v1/traces and /v1/metrics.
OTEL_ENABLED=false
OTEL_SERVICE_NAME=producer-zendesk
# OTEL_SERVICE_VERSION=0.1.0
# OTEL_RESOURCE_ATTRIBUTES=service.instance.id=team-acme-zendesk-primary,airfoil.connector.revision=1,airfoil.team.id=team-acme
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# OTEL_EXPORTER_OTLP_HEADERS=Authorization=Bearer <token>,X-Axiom-Dataset=<dataset>
